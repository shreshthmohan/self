/**
 * Wrangler configuration.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * ── Environments ────────────────────────────────────────────────────────────
 * Top level        → LOCAL development (`pnpm dev`). Local SQLite and R2, no
 *                    Cloudflare login. `database_id` is a placeholder ON
 *                    PURPOSE, so a stray bare `wrangler deploy` cannot reach a
 *                    real database.
 * `env.dev`        → worker `self-dev` at dev.shreshth.dev, D1 `self-dev`.
 * `env.production` → worker `self` at shreshth.dev, D1 `self`.
 *
 * ── How a deploy picks an environment ───────────────────────────────────────
 * The React Router build flattens ONE environment into
 * `build/server/wrangler.json`, and `wrangler deploy` deploys that. The
 * environment is chosen at BUILD time by `CLOUDFLARE_ENV` — NOT by
 * `wrangler deploy --env`. Passing `--env` to the deploy reads a config that
 * no longer has environments, so it silently deploys the wrong one.
 *
 * `scripts/build.sh` maps the pushed branch to `CLOUDFLARE_ENV`, and
 * `scripts/deploy.sh` deploys what it built. See
 * docs/adr/0006-migrations-run-in-the-deploy-command.md.
 *
 * D1 commands are the exception: `d1 migrations apply` reads THIS file and
 * does honour `--env`.
 *
 * ⚠️ Wrangler does NOT inherit `vars`, `d1_databases`, or `r2_buckets` into a
 * named environment. Every block repeats them in full.
 *
 * ⚠️ Runtime SECRETS are not here. Set them per worker with `wrangler secret
 * put` (see the README); `.dev.vars` holds them for local development.
 */
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "self",
	"main": "./workers/app.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"upload_source_maps": true,

	// ── Top level = LOCAL DEV. Bindings are local; the id is a placeholder.
	//
	// `BETTER_AUTH_URL` is the ONE origin auth answers on. It is a var and not
	// an inferred value on purpose: a version preview URL is public and carries
	// PRODUCTION bindings, so an inferred origin would make every preview a
	// second front door to the production database. See ADR 0012.
	"vars": {
		"BETTER_AUTH_URL": "http://localhost:5173"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "self-dev",
			"database_id": "PLACEHOLDER_LOCAL_ONLY_use_CLOUDFLARE_ENV_for_remote",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "self-images-dev"
		}
	],

	"env": {
		// ── E2E: the Playwright suite, LOCAL ONLY ────────────────────────────
		//
		// It never deploys. It exists because the suite needs a second local
		// origin: `BETTER_AUTH_URL` names ONE origin and auth 404s on every
		// other (ADR 0012), so the suite cannot share the top level's port with
		// a dev server the developer already has running.
		//
		// `scripts/e2e-server.sh` starts it, on port 5273 and against
		// `.wrangler/e2e-state`. `database_id` is a placeholder, like the top
		// level's, so this environment cannot reach a real database.
		"e2e": {
			"name": "self-e2e",
			"vars": {
				"BETTER_AUTH_URL": "http://localhost:5273"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "self-e2e",
					"database_id": "PLACEHOLDER_LOCAL_ONLY_the_e2e_suite_never_deploys",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "IMAGES",
					"bucket_name": "self-images-e2e"
				}
			]
		},

		// ── Deployed DEV: worker `self-dev` at dev.shreshth.dev ──────────────
		"dev": {
			"name": "self-dev",
			// Custom domain. Wrangler writes the DNS record on deploy.
			"routes": [{ "pattern": "dev.shreshth.dev", "custom_domain": true }],
			// No `self-dev.<subdomain>.workers.dev`. Auth answers on the custom
			// domain alone, so a workers.dev URL would serve a site that cannot
			// sign anybody in.
			"workers_dev": false,
			"vars": {
				"BETTER_AUTH_URL": "https://dev.shreshth.dev"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "self-dev",
					"database_id": "b43d4917-9b87-4062-87e8-7b9b44655f42",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "IMAGES",
					"bucket_name": "self-images-dev"
				}
			],
			"observability": { "enabled": true },
			"upload_source_maps": true
		},

		// ── PRODUCTION: worker `self` at shreshth.dev ────────────────────────
		"production": {
			"name": "self",
			"routes": [{ "pattern": "shreshth.dev", "custom_domain": true }],
			"workers_dev": false,
			"vars": {
				"BETTER_AUTH_URL": "https://shreshth.dev"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "self",
					"database_id": "1436b004-d08b-4a03-ae79-1d5d3b5cb8f1",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "IMAGES",
					"bucket_name": "self-images"
				}
			],
			"observability": { "enabled": true },
			"upload_source_maps": true
		}
	}
}
