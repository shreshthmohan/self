{
	"name": "self",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.8.0",
	"scripts": {
		"auth:generate": "better-auth generate --config auth-generate.config.ts --output app/db/auth-schema.ts",
		"build": "react-router build",
		"db:generate": "drizzle-kit generate",
		"deploy": "wrangler deploy",
		"dev": "react-router dev",
		"preview": "pnpm run build && vite preview",
		"test": "pnpm run test:gate && playwright test",
		"test:gate": "playwright test --config playwright.gate.config.ts",
		"typecheck": "pnpm run typegen && tsc -b",
		"typegen": "wrangler types && react-router typegen"
	},
	"dependencies": {
		"@tiptap/core": "^3.30.3",
		"@tiptap/extension-image": "^3.30.3",
		"@tiptap/extension-table": "^3.30.3",
		"@tiptap/extension-task-item": "^3.30.3",
		"@tiptap/extension-task-list": "^3.30.3",
		"@tiptap/markdown": "^3.30.3",
		"@tiptap/starter-kit": "^3.30.3",
		"better-auth": "^1.7.1",
		"drizzle-orm": "0.45.2",
		"isbot": "5.1.32",
		"marked": "^18.0.11",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "8.3.0"
	},
	"devDependencies": {
		"@better-auth/cli": "^1.4.21",
		"@cloudflare/vite-plugin": "1.52.1",
		"@playwright/test": "^1.62.1",
		"@react-router/dev": "8.3.0",
		"@tailwindcss/vite": "4.1.17",
		"@types/jsdom": "^30.0.0",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^29.1.1",
		"tailwindcss": "4.1.17",
		"typescript": "5.9.3",
		"vite": "7.3.6",
		"vite-tsconfig-paths": "5.1.4",
		"wrangler": "4.123.0"
	}
}
